{
  "name": "night-rain-taxi",
  "productName": "Night Rain Taxi",
  "version": "10.3.0",
  "description": "Fly a cab through a city where it never stops raining.",
  "author": "Pixel Stream Productions Inc.",
  "homepage": "https://lordkev007.github.io/NightRainTaxi/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.15.6"
  },
  "build": {
    "appId": "io.github.lordkev007.nightraintaxi",
    "productName": "Night Rain Taxi",
    "copyright": "© 2026 Pixel Stream Productions Inc.",
    "files": [
      "main.js",
      "preload.js",
      "game/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "./adhoc-sign.js",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "NightRainTaxi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Night Rain Taxi"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "NightRainTaxi-${version}-Linux-x64.${ext}"
    },
    "appImage": {
      "artifactName": "NightRainTaxi-${version}-SteamDeck-Linux-x64.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "NightRainTaxi-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "NightRainTaxi-${version}-mac-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
